<view class="page">
  <view class="masthead">
    <view><text class="eyebrow">CAMPUS LAB</text><view class="title">一张卡，校园日常</view></view>
    <text class="demo-badge">模拟业务</text>
  </view>

  <view class="device-panel panel">
    <view class="row spread">
      <view class="device-title"><text class="dot {{connected ? 'online' : ''}}"></text><text>{{connected ? deviceName : '连接你的校园卡终端'}}</text></view>
      <button wx:if="{{connected}}" class="quiet small-button" bindtap="disconnect" disabled="{{busy}}">断开</button>
    </view>
    <view wx:if="{{!connected}}">
      <view class="row device-actions">
        <button class="primary compact" bindtap="search" loading="{{scanning}}" disabled="{{scanning || connecting}}">{{scanning ? '搜索中' : '搜索终端'}}</button>
        <button wx:if="{{savedDeviceName}}" class="secondary compact" bindtap="reconnect" loading="{{connecting}}" disabled="{{scanning || connecting}}">重连上次设备</button>
      </view>
      <picker mode="selector" range="{{deviceOptions}}" value="{{deviceIndex}}" bindchange="selectDevice" disabled="{{connecting}}">
        <view class="picker-value">{{connecting ? '正在连接并读取设备状态…' : deviceOptions[deviceIndex]}}<text>⌄</text></view>
      </picker>
      <view class="hint">{{scanHint || '请给开发板供电，打开手机蓝牙后搜索'}}</view>
    </view>
    <view wx:else class="hardware-row">
      <text class="hardware {{readerReady ? '' : 'missing'}}">RC522 {{readerReady ? '就绪' : '未检测到'}}</text>
      <text class="hardware {{oledReady ? '' : 'missing'}}">OLED {{oledReady ? '就绪' : '未检测到'}}</text>
      <text class="hardware {{deviceStorageReady ? '' : 'missing'}}">设备存储 {{deviceStorageReady ? '就绪' : '不可用'}}</text>
      <button class="quiet small-button" bindtap="refresh" disabled="{{busy}}">刷新状态</button>
      <button wx:if="{{diagnosticsSupported}}" class="quiet small-button" bindtap="showDiagnostics" disabled="{{busy}}">设备诊断</button>
    </view>
    <view wx:if="{{diagnosticsOpen && diagnosticsView}}" class="diagnostics">
      <view class="row spread"><text class="field-label">{{stableDeviceId}}</text><button class="quiet small-button" bindtap="hideDiagnostics">收起</button></view>
      <view class="diagnostic-grid"><view>运行 {{diagnosticsView.uptime}}</view><view>空闲内存 {{diagnosticsView.heap}}</view><view>最低内存 {{diagnosticsView.minHeap}}</view><view>PSRAM {{diagnosticsView.psram}}</view><view>最长循环 {{diagnosticsView.maxLoop}}</view><view>最近读写 {{diagnosticsView.lastCard}}</view></view>
      <view class="hint">{{diagnosticsView.links}} · 数值来自设备</view>
    </view>
    <button wx:if="{{!connected}}" class="quiet permission-link" bindtap="openSettings">蓝牙权限设置</button>
  </view>

  <view class="balance-card">
    <view class="row spread"><text class="card-label">校园一卡通</text><text class="card-lab">EXPERIMENT CARD</text></view>
    <view class="balance-label">模拟余额 / 元</view>
    <view class="balance-number">{{card ? card.balanceText : '--.--'}}</view>
    <view class="row spread card-bottom">
      <view><view class="card-owner">{{card ? card.name : '等待刷卡'}}</view><view class="card-detail">{{card ? '学号 ' + card.studentNo : '待机刷卡即可查询，不会扣款'}}</view></view>
      <view class="card-number">{{card ? 'NO. ' + card.cardNo : 'NFC LAB'}}</view>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="feedback error" role="alert">{{errorText}}</view>
  <view wx:if="{{notice}}" class="feedback notice">{{notice}}</view>
  <view class="operation-strip {{hasOutstanding ? 'attention' : ''}}">
    <view class="operation-copy">{{operationHint}}</view>
    <view class="row" wx:if="{{hasOutstanding}}">
      <button class="quiet" bindtap="queryOriginal" disabled="{{!connected || busy}}">核对原订单</button>
      <button wx:if="{{canResume}}" class="quiet" bindtap="resumeOriginal" disabled="{{busy}}">重发原订单（同编号）</button>
      <button wx:if="{{canCancel}}" class="quiet" bindtap="cancel" disabled="{{busy}}">取消等待</button>
    </view>
    <view wx:if="{{outstanding}}" class="order-id">订单 {{outstanding.id}}</view>
    <view wx:if="{{outstanding && !pending}}" class="hint">只续办刚才中断的订单；久未处理请先核对余额与流水，不会自动重发。</view>
  </view>

  <view class="tabs">
    <button class="tab {{tab === 'trade' ? 'selected' : ''}}" data-tab="trade" bindtap="tabChange">办理业务</button>
    <button class="tab {{tab === 'logs' ? 'selected' : ''}}" data-tab="logs" bindtap="tabChange">交易流水</button>
    <button class="tab {{tab === 'catalog' ? 'selected' : ''}}" data-tab="catalog" bindtap="tabChange">商品配置</button>
    <button class="tab {{tab === 'screen' ? 'selected' : ''}}" data-tab="screen" bindtap="tabChange">屏幕设置</button>
  </view>

  <view wx:if="{{tab === 'trade'}}">
    <view class="panel trade-panel">
      <view class="kind-tabs">
        <button class="kind {{tradeKind === 'topup' ? 'active' : ''}}" data-kind="topup" bindtap="kindChange">充值</button>
        <button class="kind {{tradeKind === 'spend' ? 'active' : ''}}" data-kind="spend" bindtap="kindChange">消费</button>
      </view>
      <view class="section-label">{{tradeKind === 'topup' ? '充值金额' : '本次消费金额'}}</view>
      <view class="amount-field"><text>¥</text><input type="digit" value="{{amount}}" bindinput="inputAmount" maxlength="10" placeholder="0.00" disabled="{{busy || hasOutstanding}}" /></view>
      <view wx:if="{{tradeKind === 'topup'}}" class="quick-grid">
        <button wx:for="{{quickAmounts}}" wx:key="*this" data-amount="{{item}}" bindtap="chooseAmount" disabled="{{busy || hasOutstanding}}">{{item}} 元</button>
      </view>
      <view wx:else class="quick-grid">
        <button wx:for="{{products}}" wx:key="name" data-index="{{index}}" bindtap="chooseProduct" disabled="{{busy || hasOutstanding}}"><view>{{item.name}}</view><text class="product-price">¥ {{item.amount}}</text></button>
      </view>
      <view class="field-label">{{tradeKind === 'topup' ? '充值备注' : '消费场景'}}</view>
      <input value="{{scene}}" bindinput="inputScene" maxlength="24" placeholder="例如：食堂、超市、公交" disabled="{{busy || hasOutstanding}}" />
      <button class="primary action-button" bindtap="submitTrade" loading="{{busy}}" disabled="{{!canTrade}}">{{tradeKind === 'topup' ? '确认金额，等待刷卡充值' : '确认金额，等待刷卡消费'}}</button>
      <view class="hint">写卡后回读核对才显示完成。请保持卡片贴近读卡器，直到 OLED 显示结果。</view>
    </view>

    <view class="panel issue-panel">
      <view class="row spread"><view><view class="section-heading">办理新卡</view><view class="hint">使用自己的空白测试卡，初始余额 0 元</view></view><button class="secondary compact" bindtap="toggleIssue" disabled="{{busy}}">{{issueOpen ? '收起' : '开卡'}}</button></view>
      <view wx:if="{{issueOpen}}" class="issue-form">
        <view class="field-label">姓名</view><input value="{{issueName}}" bindinput="inputName" maxlength="24" placeholder="最多 8 个常用汉字" disabled="{{busy || hasOutstanding}}" />
        <view class="field-label">模拟学号</view><input value="{{studentNo}}" bindinput="inputStudentNo" maxlength="16" placeholder="例如：20260001" disabled="{{busy || hasOutstanding}}" />
        <button class="primary action-button" bindtap="submitIssue" loading="{{busy}}" disabled="{{!canTrade}}">保存资料，等待刷卡开卡</button>
      </view>
    </view>

    <view wx:if="{{lastResult}}" class="panel receipt {{lastResult.status === 'success' ? 'receipt-success' : ''}}">
      <view class="row spread"><text class="section-heading">{{lastResult.kindText}}回执</text><text class="result-badge">{{lastResult.statusText}}</text></view>
      <view class="receipt-message">{{lastResult.message}}</view>
      <view class="row spread" id="receipt-card-number"><text class="muted">回执卡号</text><text>{{lastResult.cardNo ? lastResult.cardNo : '未读取'}}</text></view>
      <view class="row spread"><text class="muted">{{lastResult.scene}}</text><text>{{lastResult.amountPrefix}}{{lastResult.amountText}} 元</text></view>
      <view class="row spread"><text class="muted">{{lastResult.balanceLabel}}</text><text>{{lastResult.balanceText}}</text></view>
      <view class="hint">{{lastResult.timeText}}</view><view class="order-id">{{lastResult.id}}</view>
    </view>
  </view>

  <view wx:if="{{tab === 'logs'}}" class="panel ledger">
    <view class="row spread"><view><view class="section-heading">终端交易记录</view><view class="hint">从设备读取最近记录</view></view><button class="secondary compact" bindtap="loadLogs" loading="{{busy}}" disabled="{{!connected || busy}}">刷新</button></view>
    <view class="log-filters">
      <input placeholder="筛选卡号" value="{{cardNoFilter}}" maxlength="12" data-field="cardNoFilter" bindinput="filterLogs" disabled="{{busy}}" />
      <input placeholder="筛选场景" value="{{sceneFilter}}" maxlength="24" data-field="sceneFilter" bindinput="filterLogs" disabled="{{busy}}" />
      <picker range="{{statusNames}}" value="{{statusIndex}}" data-field="statusIndex" bindchange="filterLogs" disabled="{{busy}}"><view class="settings-value">{{statusNames[statusIndex]}} ⌄</view></picker>
    </view>
    <view class="log-stats"><view><text class="hint">成功充值</text><view>{{logSummary.topupText}}</view></view><view><text class="hint">成功消费</text><view>{{logSummary.spendText}}</view></view><view><text class="hint">成功 / 筛选</text><view>{{logSummary.successCount}} / {{logSummary.count}}</view></view></view>
    <view class="row spread"><text class="hint">统计仅包含当前筛选的最近流水</text><button class="quiet small-button" bindtap="exportLogs" disabled="{{busy || !filteredLogs.length}}">导出 CSV</button></view>
    <view wx:if="{{!filteredLogs.length}}" class="empty-state">{{logsLoaded ? '没有符合筛选的记录' : '连接终端后，点击刷新读取交易流水'}}</view>
    <view wx:for="{{filteredLogs}}" wx:key="id" class="ledger-item">
      <view class="row spread"><text class="ledger-title">{{item.kindText}} · {{item.scene}}</text><text class="ledger-amount {{item.status === 'success' ? 'completed' : ''}}">{{item.amountPrefix}}{{item.amountText}}</text></view>
      <view class="row spread"><text class="hint">卡号 {{item.cardNo || '--'}} · {{item.statusText}}</text><text class="hint">余额 {{item.balanceText}}</text></view>
      <view class="hint">{{item.message}}</view><view class="hint">{{item.timeText}}</view><view class="order-id">{{item.id}}</view>
    </view>
  </view>

  <view wx:if="{{tab === 'catalog'}}">
    <view class="panel">
      <view class="row spread"><view><view class="section-heading">商品与消费场景</view><view class="hint">本机目录，与 PC 各自保存</view></view><button class="secondary compact" bindtap="newProduct">新增</button></view>
      <view wx:if="{{catalogError}}" class="feedback error">{{catalogError}}</view>
      <view wx:for="{{products}}" wx:key="id" class="catalog-item">
        <view><view class="ledger-title">{{item.name}} · ¥ {{item.amount}}</view><view class="hint">{{item.scene}}</view></view>
        <view class="row catalog-actions"><button class="quiet small-button" data-id="{{item.id}}" bindtap="editProduct">编辑</button><button class="quiet small-button" data-id="{{item.id}}" bindtap="deleteProduct">删除</button></view>
      </view>
      <view wx:if="{{!products.length}}" class="hint">还没有商品，消费页仍可输入自定义金额。</view>
      <view wx:if="{{productEditor}}" class="product-editor">
        <view class="field-label">{{productDraftId ? '编辑商品' : '新增商品'}}</view>
        <input placeholder="商品名称，最多 8 个常用汉字" value="{{productName}}" data-field="productName" bindinput="productInput" maxlength="24" />
        <input placeholder="金额，例如 12.50" type="digit" value="{{productAmount}}" data-field="productAmount" bindinput="productInput" maxlength="10" />
        <input placeholder="场景，例如食堂" value="{{productScene}}" data-field="productScene" bindinput="productInput" maxlength="24" />
        <view class="row"><button class="primary compact" bindtap="saveProduct">保存到本机</button><button class="quiet" bindtap="cancelProduct">取消编辑</button></view>
      </view>
    </view>
    <view class="panel">
      <view class="section-heading">自定义充值档位</view><view class="hint">1–8 个金额，用逗号分隔，例如 10, 20, 50</view>
      <view wx:if="{{catalogError}}" class="feedback error">{{catalogError}}</view>
      <input class="topup-input" value="{{topupDraft}}" data-field="topupDraft" bindinput="productInput" maxlength="120" />
      <button class="primary action-button" bindtap="saveTopups">保存本机充值档位</button>
    </view>
  </view>

  <view wx:if="{{tab === 'screen'}}" class="panel screen-panel">
    <view class="section-heading">OLED 显示偏好</view><view class="hint">SSD1306 · 128 × 64 · 设置由终端保存</view>
    <view class="oled-preview" aria-label="OLED 布局示意">
      <view class="preview-title">{{card ? card.name : '模拟校园卡'}} / 余额</view>
      <view class="preview-amount" style="font-size:{{fontSizes[fontIndex] * 2}}rpx">{{card ? card.balanceText : '37.50'}}</view>
      <view class="preview-detail">{{card ? '卡号 ' + card.cardNo : '示意布局'}} · 模拟余额</view>
    </view>
    <view class="hint preview-caption">布局示意，字形与动画以实体屏幕为准</view>
    <view class="settings-row"><text>金额字号</text><picker range="{{fontNames}}" value="{{fontIndex}}" bindchange="chooseFont" disabled="{{busy}}"><view class="settings-value">{{fontNames[fontIndex]}} ⌄</view></picker></view>
    <view class="settings-row"><text>金额展示</text><picker range="{{effectNames}}" value="{{effectIndex}}" bindchange="chooseEffect" disabled="{{busy}}"><view class="settings-value">{{effectNames[effectIndex]}} ⌄</view></picker></view>
    <view class="settings-row"><text>结果停留</text><picker range="{{holdNames}}" value="{{holdIndex}}" bindchange="chooseHold" disabled="{{busy}}"><view class="settings-value">{{holdNames[holdIndex]}} ⌄</view></picker></view>
    <view class="screen-tip">字号用于金额，中文固定为 12 像素。金额过长会自动缩小，保证完整显示；逐字模式逐位显示金额。上滑模式同时滚动长中文，其他模式会截断长文字。交易成功显示对勾与硬币动画。</view>
    <button class="primary action-button" bindtap="saveSettings" loading="{{busy}}" disabled="{{!connected || busy}}">应用并保存到终端</button>
    <view wx:if="{{settingsDirty}}" class="hint">设置尚未应用</view>
    <view class="power-section">
      <view class="section-heading">屏幕与电池模式</view>
      <view class="hint">上次确认屏幕：{{screenAwakeText}} · {{batteryText}}</view>
      <view wx:if="{{connected && !powerSupported}}" class="hint">当前固件不支持电源设置，请先更新固件。</view>
      <view wx:if="{{!connected}}" class="hint">连接终端后读取电源设置和支持能力。</view>
      <view class="settings-row"><text>电池省电模式</text><switch checked="{{batteryMode}}" data-field="batteryMode" bindchange="powerInput" disabled="{{!connected || busy || !powerSupported}}" color="#12674a" /></view>
      <view class="field-label">亮度 {{brightness}} / 255</view>
      <slider min="1" max="255" step="1" value="{{brightness}}" data-field="brightness" bindchange="powerInput" disabled="{{!connected || busy || !powerSupported}}" activeColor="#12674a" />
      <view class="field-label">闲置熄屏秒数（0 为常亮，或 10–3600）</view>
      <input type="number" value="{{idleSeconds}}" data-field="idleSeconds" bindinput="powerInput" maxlength="4" disabled="{{!connected || busy || !powerSupported}}" />
      <view class="row power-actions"><button class="primary compact" bindtap="savePower" disabled="{{!connected || busy || !powerSupported}}">保存电源设置</button><button class="secondary compact" bindtap="wakeScreen" disabled="{{!connected || busy || !powerSupported}}">唤醒屏幕</button></view>
      <view wx:if="{{powerDirty}}" class="hint">电源设置尚未应用</view>
      <view class="hint">省电模式保留蓝牙和刷卡。没有电压采样硬件时不显示电量百分比。</view>
    </view>
  </view>
  <view class="footer">自己的测试卡 · 虚拟余额 · 单终端校园实验</view>
</view>

<view wx:if="{{showPrivacy}}" class="privacy-mask" catchtap="ignorePrivacyTap">
  <view class="privacy-panel">
    <view class="section-heading">连接前的隐私说明</view>
    <view class="privacy-copy">需要使用蓝牙连接你自己的校园卡演示设备。请阅读并同意隐私指引后继续。</view>
    <button class="quiet" bindtap="openPrivacy">{{privacyName}}</button>
    <button id="agree-privacy" class="primary" open-type="agreePrivacyAuthorization" bindtap="preparePrivacyAgree" bindagreeprivacyauthorization="agreePrivacy" loading="{{privacyAgreePending}}" disabled="{{privacyAgreePending}}">同意并继续</button>
    <button class="quiet" bindtap="rejectPrivacy">暂不连接</button>
  </view>
</view>
