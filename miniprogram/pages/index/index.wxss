.page { padding:32rpx 28rpx 0; max-width:1000rpx; margin:0 auto; }
.masthead { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:10rpx 0 30rpx; }
.eyebrow { font-size:21rpx; letter-spacing:5rpx; color:#68716a; font-weight:600; }
.title { font-size:41rpx; font-weight:600; margin-top:10rpx; letter-spacing:-1rpx; }
.demo-badge { font-size:22rpx; border:2rpx solid #d8dfd8; border-radius:12rpx; padding:8rpx 12rpx; white-space:nowrap; }
.panel { background:#fff; border-radius:28rpx; padding:28rpx; margin-bottom:24rpx; box-shadow:0 6rpx 24rpx rgba(40,55,44,.035); }
.row { display:flex; align-items:center; gap:18rpx; flex-wrap:wrap; }
.spread { justify-content:space-between; }
.device-title { display:flex; align-items:center; gap:12rpx; font-size:26rpx; min-width:0; overflow-wrap:anywhere; }
.dot { width:12rpx; height:12rpx; flex-shrink:0; border-radius:50%; background:#a7afa7; }
.dot.online { background:#6f8e7a; box-shadow:0 0 0 7rpx #edf2ed; }
.device-actions { margin-top:24rpx; }
.compact { font-size:25rpx; padding:16rpx 22rpx; }
.small-button { font-size:23rpx; }
.picker-value { background:#f2f3f0; padding:22rpx; border-radius:16rpx; margin:20rpx 0 14rpx; font-size:25rpx; display:flex; justify-content:space-between; gap:10rpx; }
.hardware-row { display:flex; align-items:center; flex-wrap:wrap; gap:20rpx; margin-top:14rpx; }
.hardware { font-size:23rpx; color:#52645a; }
.hardware.missing { color:#a15b2d; }
.hint { font-size:23rpx; color:#626b65; line-height:1.65; }
.permission-link { font-size:23rpx; padding-bottom:0; }
.balance-card { border-radius:30rpx; padding:32rpx; background:linear-gradient(125deg,#354b42,#496355); color:#f5f7f4; margin-bottom:22rpx; overflow:hidden; box-shadow:0 12rpx 30rpx rgba(46,67,54,.08); }
.card-label { font-size:27rpx; font-weight:500; letter-spacing:2rpx; }
.card-lab { color:#d6e1d9; font-size:17rpx; letter-spacing:2rpx; }
.balance-label { color:#d6e1d9; font-size:23rpx; margin-top:34rpx; }
.balance-number { font-size:80rpx; font-weight:500; letter-spacing:-2rpx; line-height:1.35; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.card-bottom { margin-top:30rpx; }
.card-owner { font-size:28rpx; }
.card-detail { color:#d6e1d9; font-size:21rpx; margin-top:8rpx; }
.card-number { color:#d6e1d9; font-size:22rpx; letter-spacing:1rpx; }
.feedback { padding:22rpx 24rpx; border-radius:18rpx; font-size:25rpx; line-height:1.6; white-space:pre-wrap; overflow-wrap:anywhere; margin-bottom:18rpx; }
.error { background:#fff0ec; color:#a14337; }
.notice { background:#eff3ee; color:#4b6254; }
.operation-strip { margin:0 4rpx 26rpx; }
.operation-strip.attention { background:#fff4df; padding:22rpx; border-radius:18rpx; }
.operation-copy { font-size:25rpx; line-height:1.6; color:#626d65; }
.attention .operation-copy { color:#825c1e; }
.order-id { font-size:20rpx; color:#606c63; font-family:monospace; overflow-wrap:anywhere; margin-top:6rpx; }
.tabs { display:flex; gap:8rpx; margin:0 0 22rpx; }
.tab { flex:1; background:transparent; color:#626b65; border-radius:16rpx; padding:19rpx 10rpx; font-size:27rpx; }
.tab.selected { background:#e5ede6; color:#3f6554; }
.kind-tabs { display:flex; gap:12rpx; margin-bottom:30rpx; }
.kind { flex:1; background:#f2f3f0; color:#606c63; }
.kind.active { background:#e5ede6; color:#436955; }
.section-label { font-size:24rpx; color:#606b64; margin-bottom:10rpx; }
.amount-field { display:flex; align-items:center; gap:12rpx; margin-bottom:24rpx; }
.amount-field > text { font-size:44rpx; color:#4f6557; }
.amount-field input { font-size:66rpx; min-height:108rpx; height:112rpx; background:transparent; padding:8rpx 0; color:#354c40; font-weight:500; }
.quick-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12rpx; margin-bottom:28rpx; }
.quick-grid button { padding:20rpx 4rpx; font-size:25rpx; border-radius:15rpx; color:#4c5b52; background:#f1f3ef; overflow-wrap:anywhere; word-break:break-all; }
.product-price { display:block; font-size:20rpx; color:#626c64; margin-top:6rpx; }
.field-label { color:#535f56; font-size:25rpx; margin:20rpx 0 12rpx; }
.action-button { width:100%; margin-top:28rpx; margin-bottom:16rpx; }
.section-heading { font-size:29rpx; font-weight:500; }
.issue-panel .row { flex-wrap:nowrap; }
.issue-panel .row > view { flex:1; }
.issue-panel .row button { flex-shrink:0; }
.issue-form { margin-top:20rpx; }
.receipt-message { font-size:31rpx; margin:22rpx 0; }
.receipt > .row { margin-bottom:16rpx; }
.result-badge { font-size:22rpx; background:#f9f0dd; color:#876526; padding:6rpx 12rpx; border-radius:10rpx; }
.receipt-success .result-badge { background:#eaf0e9; color:#4a6855; }
.muted { color:#667068; }
.empty-state { padding:70rpx 0; text-align:center; color:#626d64; line-height:1.8; font-size:25rpx; }
.ledger-item { padding:28rpx 0; border-top:2rpx solid #e9ece7; margin-top:14rpx; }
.ledger-title { font-size:28rpx; }
.ledger-amount { font-size:32rpx; font-weight:500; color:#61675f; font-variant-numeric:tabular-nums; }
.ledger-amount.completed { color:#4b6c58; }
.settings-row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16rpx; padding:30rpx 0; border-bottom:2rpx solid #e8ece6; }
.settings-value { background:#f0f3ee; color:#506257; border-radius:14rpx; padding:18rpx 22rpx; font-size:26rpx; min-width:190rpx; }
.screen-tip { color:#606b64; background:#f3f4f1; border-radius:16rpx; padding:22rpx; font-size:24rpx; line-height:1.75; margin-top:24rpx; }
.footer { color:#656e67; font-size:21rpx; text-align:center; padding:22rpx 0 50rpx; padding-bottom:calc(50rpx + env(safe-area-inset-bottom)); }
.privacy-mask { position:fixed; z-index:50; left:0; right:0; top:0; bottom:0; display:flex; align-items:center; justify-content:center; background:rgba(30,40,32,.40); padding:34rpx; }
.privacy-panel { width:100%; max-width:680rpx; background:#fff; border-radius:28rpx; padding:34rpx; }
.privacy-copy { font-size:27rpx; color:#626e65; margin:24rpx 0 14rpx; line-height:1.8; }
.log-filters { display:flex; flex-wrap:wrap; gap:12rpx; margin:24rpx 0 18rpx; }
.log-filters input { flex:1; min-width:190rpx; }
.log-filters picker { width:100%; }
.log-stats { display:flex; justify-content:space-between; gap:12rpx; padding:20rpx 0; font-size:28rpx; font-variant-numeric:tabular-nums; }
.catalog-item { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding:20rpx 0; border-bottom:2rpx solid #e7ece5; }
.catalog-item > view:first-child { flex:1; min-width:0; overflow-wrap:anywhere; }
.catalog-actions { flex-shrink:0; gap:20rpx; }
.catalog-actions button { min-height:80rpx; }
.product-editor { display:flex; flex-direction:column; gap:16rpx; margin-top:24rpx; }
.topup-input { margin-top:24rpx; }
.power-section { border-top:2rpx solid #e1e7de; margin-top:34rpx; padding-top:28rpx; }
.power-actions { margin:24rpx 0 16rpx; }
.diagnostics { margin-top:20rpx; padding-top:12rpx; border-top:2rpx solid #e7ece5; }
.diagnostic-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; font-size:23rpx; margin-bottom:14rpx; color:#586b5e; }
.oled-preview { width:256rpx; height:128rpx; margin:24rpx auto 10rpx; background:#151c18; color:#eff3ee; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; font-family:monospace; }
.preview-title,.preview-detail { font-size:24rpx; line-height:1; white-space:nowrap; overflow:hidden; }
.preview-amount { text-align:center; line-height:1; white-space:nowrap; }
.preview-caption { text-align:center; }
