page { background:#f5f7fb; color:#24334b; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:28rpx; }
view, text, button, input, picker { box-sizing:border-box; }
button { margin:0; font-size:28rpx; font-weight:500; border-radius:20rpx; line-height:1.5; padding:22rpx 28rpx; background:#eef3f9; color:#354b65; }
button::after { border:0; }
button[disabled] { background:#e9eef5!important; color:#6b7f99!important; }
.primary { color:#fff; background:#3564db; }
.secondary { color:#3564db; background:#eaf1ff; }
.quiet { color:#526780; background:transparent; padding:14rpx 0; }
input { width:100%; min-height:88rpx; padding:20rpx 22rpx; background:#f1f5fa; border:2rpx solid transparent; border-radius:16rpx; font-size:30rpx; }
input:focus { border-color:#4f82e4; }
