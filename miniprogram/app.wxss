page { background:#f6f7f5; color:#293b35; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:28rpx; }
view, text, button, input, picker { box-sizing:border-box; }
button { margin:0; font-size:28rpx; font-weight:500; border-radius:20rpx; line-height:1.5; padding:22rpx 28rpx; background:#f0f2ef; color:#46534d; }
button::after { border:0; }
button[disabled] { background:#e9ece7!important; color:#727c73!important; }
.primary { color:#fff; background:#4f7567; }
.secondary { color:#4f7567; background:#eef2ee; }
.quiet { color:#606962; background:transparent; padding:14rpx 0; }
input { width:100%; min-height:88rpx; padding:20rpx 22rpx; background:#f2f3f0; border:2rpx solid transparent; border-radius:16rpx; font-size:30rpx; }
input:focus { border-color:#7e9886; }
