page { background:#f3f7f5; color:#182d27; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:28rpx; }
view, text, button, input, picker { box-sizing:border-box; }
button { margin:0; font-size:28rpx; font-weight:500; border-radius:20rpx; line-height:1.5; padding:22rpx 28rpx; background:#edf3f0; color:#24483b; }
button::after { border:0; }
button[disabled] { background:#e9eeeb!important; color:#95a39c!important; }
.primary { color:#fff; background:#12674a; }
.secondary { color:#12674a; background:#e6f1eb; }
.quiet { color:#4b6258; background:transparent; padding:14rpx 0; }
input { width:100%; min-height:88rpx; padding:20rpx 22rpx; background:#f2f6f3; border:2rpx solid transparent; border-radius:16rpx; font-size:30rpx; }
input:focus { border-color:#4b8e72; }
